#=============================================================================#
#  picom.conf — Material Design 3 compositor config for bspwm
#-----------------------------------------------------------------------------#
#  СГЕНЕРИРОВАНО АВТОМАТИЧЕСКИ из tools/templates/picom.conf.template
#  Источник правды:  generated/theme-state.json  →  tools/md3_theme.py
#  Не правьте вручную — изменения затрёт следующий `md3-theme-gui.py --apply`.
#
#  Все цвета ниже — роли md.sys.color.* (Material Color Utilities),
#  тени — md.sys.elevation (overlay surfaceTint), motion — md.sys.motion.
#
#  Требуется picom с поддержкой `rules` (v10+). Блок `animations` появляется
#  только если включён чекбокс «Window animations» (нужен picom с animation
#  script system — v11+/next).
#=============================================================================#

#-----------------------------------------------------------------------------
# Переменные темы (md3_*). Значения подставлены генератором.
#-----------------------------------------------------------------------------
md3_corner_radius       = {{MD3_CORNER_RADIUS}};        # md.sys.shape.{{MD3_CORNER_RADIUS_TOKEN}}
md3_shadow_color        = "{{MD3_SHADOW_COLOR}}";       # md.sys.color.shadow
md3_shadow_opacity      = {{MD3_SHADOW_ALPHA}};         # md.sys.elevation level {{MD3_ELEVATION_LEVEL}}
md3_shadow_radius       = {{MD3_SHADOW_RADIUS}};        # ≈ blur / 2
md3_shadow_offset_x     = {{MD3_SHADOW_OFFSET_X}};
md3_shadow_offset_y     = {{MD3_SHADOW_OFFSET_Y}};
md3_active_opacity      = {{MD3_ACTIVE_OPACITY}};
md3_inactive_opacity    = {{MD3_INACTIVE_OPACITY}};
md3_frame_opacity       = {{MD3_FRAME_OPACITY}};
md3_blur_strength       = {{MD3_BLUR_STRENGTH}};
md3_surface             = "{{MD3_SURFACE}}";            # md.sys.color.surface
md3_surface_container   = "{{MD3_SURFACE_CONTAINER}}";  # md.sys.color.surface-container
md3_elevation1          = "{{MD3_ELEVATION_LEVEL1}}";
md3_elevation2          = "{{MD3_ELEVATION_LEVEL2}}";
md3_elevation3          = "{{MD3_ELEVATION_LEVEL3}}";
md3_elevation4          = "{{MD3_ELEVATION_LEVEL4}}";
md3_elevation5          = "{{MD3_ELEVATION_LEVEL5}}";
# md.sys.motion
md3_duration_medium3    = 0.350;   # enter  (350 ms)
md3_duration_short3     = 0.150;   # exit   (150 ms)
md3_duration_short1     = 0.050;   # fade иконки/прозрачности (50 ms, linear)
md3_easing_decelerate   = "cubic-bezier(0.05, 0.7, 0.1, 1.0)";   # md.sys.motion.easing.emphasized-decelerate
md3_easing_accelerate   = "cubic-bezier(0.3, 0.0, 0.8, 0.15)";   # md.sys.motion.easing.emphasized-accelerate
md3_anim_scale          = {{MD3_ANIMATION_SCALE}};

#-----------------------------------------------------------------------------
# Backend
#-----------------------------------------------------------------------------#
#?if EGL
backend = "egl";          # рекомендуется: меньше задержки, чем glx
#?endif
#?if GLX
backend = "glx";          # fallback для старых драйверов (проверено на NVIDIA-legacy)
#?endif
vsync = true;
use-damage = true;        # перерисовывать только изменённые области
dithered-present = false; # включите, если видите banding на градиентах
# no-frame-pacing = true; # раскомментируйте при статтерах на некоторых GPU

#-----------------------------------------------------------------------------
# Окна: фокус, прозрачность, геометрия
#-----------------------------------------------------------------------------#
mark-wmwin-focused = true;
mark-ovredir-focused = true;
detect-rounded-corners = true;
detect-client-opacity = true;
detect-transient = true;
detect-client-leader = true;
use-ewmh-active-win = true;        # bspwm поддерживает _NET_ACTIVE_WINDOW
unredir-if-possible = true;        # fullscreen-видео без композитинга
unredir-if-possible-delay = 100;
resize-damage = 2;
glx-no-stencil = true;
glx-copy-from-front = false;
# transparent-clipping = false;    # НЕ включать: конфликтует с corner-radius

#-----------------------------------------------------------------------------
# Fading (md.sys.motion: плавное появление/исчезновение)
#-----------------------------------------------------------------------------#
fading = {{FLAG_FADE}};
fade-in-step = {{MD3_FADE_STEP}};
fade-out-step = {{MD3_FADE_STEP}};
fade-delta = 8;                    # ~120 fps шаг; 8 ms ≈ короткая MD3-длительность
no-fading-destroyed-argb = true;

#-----------------------------------------------------------------------------
# Blur
#-----------------------------------------------------------------------------#
#?if BLUR
blur-method = "dual_kawase";
blur-strength = {{MD3_BLUR_STRENGTH}};
blur-background = false;           # включаем точечно в rules (лаунчеры/попапы)
blur-background-frame = true;
blur-background-fixed = true;
#?endif
#?if NO_BLUR
blur-method = "none";
blur-background = false;
#?endif

#-----------------------------------------------------------------------------
# Corners & shadows
#-----------------------------------------------------------------------------#
corner-radius = {{MD3_CORNER_RADIUS}};
shadow = {{FLAG_SHADOWS}};
shadow-radius = {{MD3_SHADOW_RADIUS}};
shadow-opacity = {{MD3_SHADOW_ALPHA}};
shadow-offset-x = {{MD3_SHADOW_OFFSET_X}};
shadow-offset-y = {{MD3_SHADOW_OFFSET_Y}};
shadow-color = "{{MD3_SHADOW_COLOR}}";     # md.sys.color.shadow
shadow-ignore-shaped = false;
# shadow-exclude / opacity-rule / focus-exclude здесь НЕ используются:
# при заданном `rules` picom их игнорирует (см. WINDOW RULES в man picom).

frame-opacity = {{MD3_FRAME_OPACITY}};
inactive-opacity-override = false;

#-----------------------------------------------------------------------------
# WINDOW RULES
#-----------------------------------------------------------------------------#
# ВАЖНО: как только задан `rules`, легаси-опции (inactive-opacity,
# shadow-exclude, opacity-rule, focus-exclude, rounded-corners-exclude и
# `wintypes`) ИГНОРИРУЮТСЯ picom'ом. Поэтому всё поведение описано здесь.
# Правила применяются по порядку; последнее совпадение побеждает.
#-----------------------------------------------------------------------------#
rules = (
  #--- 1. БАЗА: активное окно ------------------------------------------------#
  {
    match   = "focused";
    opacity = {{MD3_ACTIVE_OPACITY}};
  },

  #--- 2. БАЗА: неактивные окна ----------------------------------------------#
  {
    match   = "!focused";
    opacity = {{MD3_INACTIVE_OPACITY}};
#?if INACTIVE_DIM
    dim     = 0.06;                 # лёгкое затемнение поверх прозрачности
#?endif
  },

  #--- 3. ИСКЛЮЧЕНИЕ: ПОЛНОЭКРАННЫЕ ОКНА -------------------------------------#
  # Без скруглений (иначе видны уголки), без тени, без blur, без затемнения;
  # композитинг для них отключаем (unredir) — максимум FPS в играх/видео.
  {
    match         = "fullscreen";
    shadow        = false;
    corner-radius = 0;
    blur-background = false;
    opacity       = 1.0;
    dim           = 0.0;
    unredir       = true;
  },

  #--- 4. ИСКЛЮЧЕНИЕ: ТЕРМИНАЛЫ ----------------------------------------------#
  # Терминал — рабочий инструмент: без тени и без прозрачности, чтобы текст
  # не «плыл» и не бликовал. Скругление углов остаётся (оно не мешает чтению).
  {
    match = "class_g %= 'Alacritty'          || "
            "class_g %= 'kitty'              || "
            "class_g %= 'WezTerm'            || "
            "class_g %= 'foot'               || "
            "class_g %= 'XTerm'              || "
            "class_g %= 'URxvt'               || "
            "class_g %= 'st-256color'         || "
            "class_g %= 'Tabby'               || "
            "class_g %= 'Hyper'               || "
            "class_g %= 'Terminator'          || "
            "class_g %= 'Tilix'               || "
            "class_g %= 'Konsole'             || "
            "class_g %= 'Gnome-terminal'      || "
            "class_g %= 'Xfce4-terminal'      || "
            "class_i %= 'term'";
    shadow  = false;
    opacity = 1.0;
    dim     = 0.0;
  },

  #--- 5. Панель (polybar) и обои --------------------------------------------#
  {
    match         = "window_type = 'dock' || window_type = 'desktop'";
    shadow        = false;
    corner-radius = 0;
    blur-background = false;
    opacity       = 1.0;
    dim           = 0.0;
  },

  #--- 6. Всплывающее / служебное --------------------------------------------#
  {
    match         = "window_type = 'tooltip' || window_type = 'combo' || "
                    "window_type = 'dnd'     || window_type = 'splash'";
    shadow        = false;
    corner-radius = {{MD3_CORNER_RADIUS}};
    opacity       = 1.0;
    fade          = false;
  },

#?if ROUND_DIALOGS
  #--- 7. Диалоги и утилитарные окна: elevation 3 + скругление ---------------#
  {
    match         = "window_type = 'dialog' || window_type = 'utility' || "
                    "window_type = 'menu'   || window_type = 'dropdown_menu' || "
                    "window_type = 'popup_menu'";
    corner-radius = {{MD3_CORNER_RADIUS}};
    shadow        = true;
    shadow-color  = "{{MD3_SHADOW_COLOR}}";
    shadow-opacity = 0.36;          # md.sys.elevation level 3
    shadow-radius = 11;
    shadow-offset-y = 6;
  },
#?endif

  #--- 8. Лаунчеры и уведомления: blur + elevation 4 -------------------------#
  {
    match = "class_g %= 'rofi'       || class_g %= 'wofi'     || "
            "class_g %= 'fuzzel'     || class_g %= 'bemenu'   || "
            "class_g %= 'Dunst'      || class_g %= 'mako'     || "
            "class_g %= 'swaync'     || class_g %= 'Notify-osd' || "
            "class_g %= 'dragon'";
#?if BLUR
    blur-background = true;
    blur-opacity    = 1.0;
#?endif
    shadow        = true;
    shadow-opacity = 0.40;          # md.sys.elevation level 4
    shadow-radius = 14;
    shadow-offset-y = 8;
    corner-radius = {{MD3_CORNER_RADIUS}};
    opacity       = 1.0;
  },

  #--- 9. Окна, которые всегда считаются активными (не затемнять) ------------#
  {
    match   = "class_g %= 'rofi' || class_g %= 'wofi' || class_g %= 'fuzzel' || "
              "class_g %= 'bemenu' || class_g %= 'Dunst' || class_g %= 'mako' || "
              "class_g %= 'Picture-in-picture' || name %= 'Picture-in-Picture'";
    opacity = 1.0;
    dim     = 0.0;
  },

  #--- 10. Скриншоттеры: не применять transparent clipping -------------------#
  {
    match            = "class_g %= 'flameshot' || class_g %= 'Shutter' || "
                       "class_g %= 'scrot'     || class_g %= 'ksnip'";
    shadow           = false;
    corner-radius    = 0;
    blur-background  = false;
  }
);

#-----------------------------------------------------------------------------
# ANIMATIONS — md.sys.motion (появление/исчезновение окна)
#-----------------------------------------------------------------------------#
# enter: 350 ms, emphasized-decelerate  cubic-bezier(0.05, 0.7, 0.1, 1.0)
# exit : 150 ms, emphasized-accelerate  cubic-bezier(0.3, 0.0, 0.8, 0.15)
# opacity всегда анимируется 50 ms linear — как у MD3-чекбокса.
# Масштабирование идёт от левого верхнего угла, поэтому компенсируем его
# offset'ами на половину дельты размера окна.
#-----------------------------------------------------------------------------#
#?if ANIMATIONS
animations = (
  #--- OPEN: appear (scale md3_anim_scale → 1.0) -----------------------------#
  {
    triggers = [ "open", "show" ];
    suppressions = [ "close", "hide" ];

    var-progress = {
      curve    = "{{MD3_EASING_EMPHASIZED_DECELERATE}}";
      duration = {{MD3_ANIMATION_DURATION_S}};   # md.sys.motion.duration.medium3 = 350 ms
      start    = 0;
      end      = 1;
    };
    var-scale = "{{MD3_ANIMATION_SCALE}} + (1 - {{MD3_ANIMATION_SCALE}}) * var-progress";

    scale-x = "var-scale";
    scale-y = "var-scale";
    offset-x = "window-width  * (1 - var-scale) / 2";
    offset-y = "window-height * (1 - var-scale) / 2";

    shadow-scale-x = "var-scale";
    shadow-scale-y = "var-scale";
    shadow-offset-x = "window-width  * (1 - var-scale) / 2";
    shadow-offset-y = "window-height * (1 - var-scale) / 2";

    opacity = {
      curve    = linear;
      duration = 0.050;   # md.sys.motion.duration.short1 = 50 ms
      start    = 0;
      end      = 1;
    };
  },

  #--- CLOSE / HIDE: disappear (scale 1.0 → 1.02 + fade out) -----------------#
  {
    triggers = [ "close", "hide" ];
    suppressions = [ "open", "show" ];

    var-progress = {
      curve    = "{{MD3_EASING_EMPHASIZED_ACCELERATE}}";
      duration = 0.150;   # md.sys.motion.duration.short3 = 150 ms
      start    = 0;
      end      = 1;
    };
    var-scale = "1 + 0.02 * var-progress";

    scale-x = "var-scale";
    scale-y = "var-scale";
    offset-x = "window-width  * (1 - var-scale) / 2";
    offset-y = "window-height * (1 - var-scale) / 2";

    shadow-scale-x = "var-scale";
    shadow-scale-y = "var-scale";
    shadow-offset-x = "window-width  * (1 - var-scale) / 2";
    shadow-offset-y = "window-height * (1 - var-scale) / 2";

    # без явной opacity закрытое окно исчезнет мгновенно
    opacity = {
      curve    = linear;
      duration = 0.150;   # md.sys.motion.duration.short3 = 150 ms
      start    = 1;
      end      = 0;
    };
  }
);
#?endif

#-----------------------------------------------------------------------------
# Прочее
#-----------------------------------------------------------------------------#
log-level = "warn";
# log-file = "/home/USER/.local/state/bspwm-md3/picom.log";
# dbus = true;            # включите для управления picom из скриптов
# write-pid-path = "~/.local/state/bspwm-md3/picom.pid";
